{
  "expo": {
    "name": "CRM Sucata",
    "slug": "crm-sucata-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sucata.crm",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O CRM Sucata precisa da sua localizacao para validar visitas via GPS.",
        "NSCameraUsageDescription": "O CRM Sucata precisa acessar a camera para tirar fotos das visitas.",
        "NSPhotoLibraryUsageDescription": "O CRM Sucata precisa acessar suas fotos para anexar documentos.",
        "NSContactsUsageDescription": "O CRM Sucata acessa seus contatos para registrar chamadas automaticamente."
      }
    },
    "android": {
      "package": "com.sucata.crm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_CONTACTS",
        "android.permission.INTERNET",
        "android.permission.FOREGROUND_SERVICE"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "*.railway.app"
            }
          ],
          "category": ["android.intent.category.BROWSABLE", "android.intent.category.DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "seu-project-id-aqui"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O CRM Sucata precisa da sua localizacao para validar visitas via GPS.",
          "locationWhenInUsePermission": "O CRM Sucata precisa da sua localizacao para validar visitas via GPS."
        }
      ]
    ]
  }
}
