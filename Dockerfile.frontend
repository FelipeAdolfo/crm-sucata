# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar package.json
COPY crm-portal/frontend/package*.json ./
RUN npm install

# Copiar código e buildar
COPY crm-portal/frontend/ .
RUN npm run build

# Runtime stage - Nginx
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY crm-portal/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
